DATABASE_URL=mysql://root:change_me@127.0.0.1:3306/chat
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=2h
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d
APP_ENCRYPTION_KEY=

# Storage
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./uploads
STORAGE_PUBLIC_BASE_URL=http://localhost:3001/api
STORAGE_SIGNING_SECRET=dev-storage-signing-secret-change-me
STORAGE_SIGNED_URL_TTL_SECONDS=600

# S3-compatible storage (only when STORAGE_DRIVER=s3)
# S3_ENDPOINT=
# S3_REGION=us-east-1
# S3_BUCKET=
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
# S3_FORCE_PATH_STYLE=false

# Queue
QUEUE_PREFIX=contract:

# Admin dashboard cost estimate (CNY per one million tokens).
MODEL_COST_INPUT_PER_MILLION_TOKENS=0
MODEL_COST_OUTPUT_PER_MILLION_TOKENS=0
